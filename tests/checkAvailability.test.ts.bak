import { describe, it, expect, vi, beforeEach } from "vitest";

interface CheckAvailabilityRequest {
  receptionistId: string;
  serviceId?: string | null;
  startDate?: string;
  endDate?: string;
  timezone?: string | null;
  durationMinutes?: number | null;
  maxSlots?: number;
  desiredStart?: string | null;
  desiredEnd?: string | null;
}

async function checkAvailability(request: {
  receptionistId: string;
  serviceId?: string | null;
  startDate?: string;
  endDate?: string;
  timezone?: string | null;
  durationMinutes?: number | null;
  maxSlots?: number;
  desiredStart?: string | null;
  desiredEnd?: string | null;
}): Promise<{
  success: boolean;
  available?: boolean;
  slots: Array<{
    start: string;
    end: string;
    display: string;
    score?: number;
    reason?: string;
  }>;
  alternatives?: Array<{
    start: string;
    end: string;
    display: string;
    score: number;
    reason: string;
  }>;
  service?: { id: string; name: string; duration_minutes: number } | null;
  error?: string;
}> {
  const { data, error } = await fetch("https://esvrhnlwquunsdduvbnr.supabase.co/functions/v1/check-availability", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "Authorization": `Bearer ${import.meta.env.VITE_SUPABASE_ANON_KEY}`,
    },
    body: JSON.stringify(request),
  });

  if (error) throw error;
  return data.json();
}

function createMockResponse(body: any, ok: boolean = true) {
  return {
    ok: true,
    status: 200,
    json: async () => body,
  };
}

describe("checkAvailability", () => {
  beforeEach(() => {
    globalThis.fetch = vi.fn();
  });

  const validRequest = {
    receptionistId: "rec-001",
    serviceId: "svc-001",
    startDate: "2026-08-15",
    endDate: "2026-08-22",
    timezone: "America/Sao_Paulo",
    durationMinutes: 60,
    maxSlots: 10,
  };

  it("returns available slots for a date range", async () => {
    globalThis.fetch = vi.fn().mockResolvedValue(createMockResponse({
      success: true,
      available: true,
      slots: [
        { start: "2026-08-15T09:00:00Z", end: "2026-08-15T10:00:00Z", display: "Aug 15, 9:00 AM" },
        { start: "2026-08-15T11:00:00Z", end: "2026-08-15T12:00:00Z", display: "Aug 15, 11:00 AM" },
        { start: "2026-08-16T09:00:00Z", end: "2026-08-16T10:00:00Z", display: "Aug 16, 9:00 AM" },
      ],
      service: { id: "svc-001", name: "Dental Cleaning", duration_minutes: 60 },
    }));

    const result = await checkAvailability({
      receptionistId: "rec-001",
      serviceId: "svc-001",
      startDate: "2026-08-15",
      endDate: "2026-08-22",
      timezone: "America/Sao_Paulo",
      durationMinutes: 60,
      maxSlots: 10,
    });

    expect(result.success).toBe(true);
    expect(result.available).toBe(true);
    expect(result.slots).toHaveLength(3);
    expect(result.slots[0].start).toBe("2026-08-15T09:00:00Z");
    expect(result.service?.name).toBe("Dental Cleaning");
  });

  it("returns unavailable when no slots match", async () => {
    globalThis.fetch = vi.fn().mockResolvedValue(createMockResponse({
      success: true,
      available: false,
      slots: [],
      alternatives: [
        { start: "2026-08-15T10:00:00Z", end: "2026-08-15T11:00:00Z", display: "Aug 15, 10:00 AM", score: 0.8, reason: "Closest available" },
      ],
    }));

    const result = await checkAvailability({
      receptionistId: "rec-001",
      serviceId: "svc-001",
      startDate: "2026-08-15",
      endDate: "2026-08-22",
      desiredStart: "2026-08-15T10:00:00Z",
      desiredEnd: "2026-08-15T11:00:00Z",
    });

    expect(result.success).toBe(true);
    expect(result.available).toBe(false);
    expect(result.slots).toHaveLength(0);
    expect(result.alternatives).toHaveLength(1);
  });

  it("returns scored alternatives when exact time not available", async () => {
    globalThis.fetch = vi.fn().mockResolvedValue(createMockResponse({
      success: true,
      available: false,
      slots: [],
      alternatives: [
        { start: "2026-08-15T09:00:00Z", end: "2026-08-15T10:00:00Z", display: "Aug 15, 9:00 AM", score: 0.9, reason: "1 hour earlier" },
        { start: "2026-08-15T11:00:00Z", end: "2026-08-15T12:00:00Z", display: "Aug 15, 11:00 AM", score: 0.8, reason: "1 hour later" },
        { start: "2026-08-16T10:00:00Z", end: "2026-08-16T11:00:00Z", display: "Aug 16, 10:00 AM", score: 0.5, reason: "Next day" },
      ],
    }));

    const result = await checkAvailability({
      receptionistId: "rec-001",
      serviceId: "svc-001",
      desiredStart: "2026-08-15T10:00:00Z",
      desiredEnd: "2026-08-15T11:00:00Z",
    });

    expect(result.success).toBe(true);
    expect(result.available).toBe(false);
    expect(result.alternatives).toHaveLength(3);
    expect(result.alternatives[0].score).toBe(0.9);
    expect(result.alternatives[1].score).toBe(0.8);
    expect(result.alternatives[2].score).toBe(0.5);
  });

  it("handles specific time request with desiredStart/desiredEnd", async () => {
    globalThis.fetch = vi.fn().mockResolvedValue(createMockResponse({
      success: true,
      available: true,
      slots: [
        { start: "2026-08-15T14:00:00Z", end: "2026-08-15T15:00:00Z", display: "Aug 15, 2:00 PM" },
      ],
    }));

    const result = await checkAvailability({
      receptionistId: "rec-001",
      serviceId: "svc-001",
      desiredStart: "2026-08-15T14:00:00Z",
      desiredEnd: "2026-08-15T15:00:00Z",
    });

    expect(result.success).toBe(true);
    expect(result.available).toBe(true);
    expect(result.slots).toHaveLength(1);
  });

  it("handles service not found", async () => {
    globalThis.fetch = vi.fn().mockResolvedValue({
      ok: true,
      json: async () => ({
        success: false,
        error: "Service not found",
      }),
    });

    const result = await checkAvailability({
      receptionistId: "rec-001",
      serviceId: "svc-nonexistent",
    });

    expect(result.success).toBe(false);
    expect(result.error).toContain("Service not found");
  });

  it("handles timezone conversion correctly", async () => {
    globalThis.fetch = vi.fn().mockResolvedValue({
      ok: true,
      json: async () => ({
        success: true,
        available: true,
        slots: [
          { start: "2026-08-15T13:00:00Z", end: "2026-08-15T15:00:00Z", display: "Aug 15, 10:00 AM" },
        ],
      }),
    });

    const result = await checkAvailability({
      receptionistId: "rec-001",
      serviceId: "svc-001",
      startDate: "2026-08-15",
      endDate: "2026-08-15",
      timezone: "America/Sao_Paulo",
    });

    expect(result.success).toBe(true);
    expect(result.slots[0].start).toBe("2026-08-15T13:00:00Z");
  });

  it("handles service duration correctly", async () => {
    globalThis.fetch = vi.fn().mockResolvedValue({
      ok: true,
      json: async () => ({
        success: true,
        available: true,
        slots: [
          { start: "2026-08-15T09:00:00Z", end: "2026-08-15T10:30:00Z", display: "Aug 15, 9:00 AM" },
          { start: "2026-08-15T11:00:00Z", end: "2026-08-15T12:30:00Z", display: "Aug 15, 11:00 AM" },
        ],
        service: { id: "svc-001", name: "Dental Cleaning", duration_minutes: 90 },
      }),
    });

    const result = await checkAvailability({
      receptionistId: "rec-001",
      serviceId: "svc-001",
      durationMinutes: 90,
    });

    expect(result.success).toBe(true);
    expect(result.service?.duration_minutes).toBe(90);
    expect(result.slots[0].end).toBe("2026-08-15T10:30:00Z");
    expect(result.slots[1].end).toBe("2026-08-15T12:30:00Z");
  });

  it("handles maxSlots limit", async () => {
    globalThis.fetch = vi.fn().mockResolvedValue({
      ok: true,
      json: async () => ({
        success: true,
        available: true,
        slots: Array.from({ length: 5 }, (_, i) => ({
          start: new Date("2026-08-15T09:00:00Z").toISOString(),
          end: new Date("2026-08-15T10:00:00Z").toISOString(),
          display: "Aug 15, 9:00 AM",
        }),
      }),
    });

    const result = await checkAvailability({
      receptionistId: "rec-001",
      serviceId: "svc-001",
      maxSlots: 5,
    });

    expect(result.success).toBe(true);
    expect(result.slots).toHaveLength(5);
  });

  it("handles missing receptionistId", async () => {
    globalThis.fetch = vi.fn().mockResolvedValue({
      ok: true,
      json: async () => ({
        success: false,
        error: "receptionistId is required",
      }),
    });

    const result = await checkAvailability({
      receptionistId: "",
      serviceId: "svc-001",
    });

    expect(result.success).toBe(false);
    expect(result.error).toContain("receptionistId is required");
  });

  it("handles network error gracefully", async () => {
    globalThis.fetch = vi.fn().mockRejectedValue(new Error("Network error"));

    const result = await checkAvailability({
      receptionistId: "rec-001",
      serviceId: "svc-001",
    });

    expect(result.success).toBe(false);
    expect(result.error).toContain("Network error");
  });

  it("handles 429 rate limit with retry suggestion", async () => {
    globalThis.fetch = vi.fn().mockResolvedValue({
      ok: false,
      status: 429,
      json: async () => ({
        success: false,
        error: "Rate limit exceeded. Please try again in 30 seconds.",
      }),
    });

    const result = await checkAvailability({
      receptionistId: "rec-001",
      serviceId: "svc-001",
    });

    expect(result.success).toBe(false);
    expect(result.error).toContain("Rate limit");
  });
});