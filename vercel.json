{
  "rewrites": [
    {
      "source": "/((?!assets|favicon|robots|widget-embed|placeholder).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/widget-embed.js",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/widget",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    }
  ]
}
